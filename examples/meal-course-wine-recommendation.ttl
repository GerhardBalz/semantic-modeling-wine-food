@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix smo: <https://w3id.org/smo#> .
@prefix mod: <https://w3id.org/mod#> .
@prefix smwf: <https://w3id.org/semantic-modeling-wine-food/> .

smwf:MealCourseWineRecommendationModel
    a smo:SemanticModel ;
    dcterms:title "Meal-course wine recommendation semantic model"@en ;
    dcterms:description "A bounded purpose-specific semantic model that recommends candidate wines from explicit meal-course and preference facts while preserving lineage to the historical W3C Wine and Food semantic models."@en ;
    dcterms:source smwf:W3COwlGuideWine, smwf:W3COwlGuideFood ;
    prov:wasDerivedFrom smwf:W3COwlGuideWine, smwf:W3COwlGuideFood ;
    mod:competencyQuestion "Which candidate wines match this meal course and preference profile?"@en .

smwf:suitableForCourse a owl:ObjectProperty .
smwf:hasBody a owl:DatatypeProperty .
smwf:preferredBody a owl:DatatypeProperty .
smwf:course a owl:ObjectProperty .
smwf:candidateWine a owl:ObjectProperty .

smwf:MainCourse a smwf:MealCourse .
smwf:DessertCourse a smwf:MealCourse .
smwf:MealCourse a owl:Class .
smwf:WineCandidate a owl:Class .
smwf:RecommendationRequest a owl:Class .

smwf:CabernetCandidate
    a smwf:WineCandidate ;
    rdfs:label "Cabernet candidate"@en ;
    smwf:suitableForCourse smwf:MainCourse ;
    smwf:hasBody "full" .

smwf:RieslingCandidate
    a smwf:WineCandidate ;
    rdfs:label "Riesling candidate"@en ;
    smwf:suitableForCourse smwf:DessertCourse ;
    smwf:hasBody "light" .

smwf:MainCourseFullBodyRequest
    a smwf:RecommendationRequest ;
    smwf:course smwf:MainCourse ;
    smwf:preferredBody "full" ;
    smwf:candidateWine smwf:CabernetCandidate, smwf:RieslingCandidate .
